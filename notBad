#include <stdio.h>

int i;
int sum = 0;

int sumArray(int arr[], int n){
    for (i = 0; i < n; i++){
            sum = sum + arr[i];
            }
    return sum; 
}

int main() {
    int n;
    scanf("%d", &n);
    
    int arr[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    printf("Sum: %d", sumArray(arr, n));

    return 0;
}
